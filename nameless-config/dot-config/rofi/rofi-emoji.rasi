

@theme "colors.rasi"

configuration {
    font:                       "Ubuntu Nerd Font Medium 14";

    show-icons:                 false;

    disable-history:            true;
    fullscreen:                 false;

    hide-scrollbar:             true;
    sidebar-mode:               false;

    drun-display-format:        "{name}";
}


window {
    transparency:               "real";

    location:                   center;
    anchor:                     center;

    width:                      540px;

    border:                     1px solid;
    border-radius:              28px;

    border-color:               rgba(255,255,255,0.08);

    background-color:           rgba(20,20,20,0.65);

    text-color:                 @on-surface;
}


mainbox {
    spacing:                    18px;
    padding:                    24px;

    background-color:           transparent;

    children:                   [ "inputbar", "listview" ];
}


inputbar {
    children:                   [ "entry" ];

    spacing:                    0px;

    padding:                    14px 18px;

    border:                     1px solid;
    border-radius:              999px;

    border-color:               rgba(255,255,255,0.06);

    background-color:           rgba(255,255,255,0.07);
}

entry {
    background-color:           transparent;

    text-color:                 @on-surface;

    placeholder:                "Search emoji";

    placeholder-color:          rgba(255,255,255,0.45);
}


listview {
    columns:                    4;
    lines:                      10;

    spacing:                    10px;

    cycle:                      true;
    dynamic:                    true;

    fixed-height:               false;

    background-color:           transparent;
}


element {
    background-color:           transparent;

    border:                     0px;
    border-radius:              16px;

    padding:                    10px;

    text-color:                 @on-surface;

    orientation:                horizontal;
}


element-text {
    background-color:           transparent;

    text-color:                 inherit;

    font:                       "Ubuntu Nerd Font Medium 18";

    horizontal-align:           0.5;
    vertical-align:             0.5;
}


element selected {
    background-color:           @secondary-container;

    text-color:                 @on-secondary-container;

    border:                     1px solid;
    border-color:               rgba(255,255,255,0.08);

    border-radius:              16px;
}


element-icon {
    enabled:                    false;
}
