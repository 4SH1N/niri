{
  "layer": "top",
  "position": "top",
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 0,
  "modules-left": [
    "niri/workspaces",
    "niri/window"
  ],
  "modules-center": [
    "custom/cava",
    "clock",
    "custom/swaync"
  ],
  "modules-right": [
    "tray",
    "niri/language",
    "backlight",
    "pulseaudio",
    "keyboard-state",
    "battery"
  ],
  "custom/cava": {
    "format": "{}",
    "exec": "~/.config/waybar/cava.sh",
    "restart-interval": 1,
    "hide-empty": true,
    "tooltip": false
  },
  "niri/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "1": "I",
      "2": "II",
      "3": "III",
      "4": "IV",
      "5": "V",
      "6": "VI",
      "7": "VII",
      "8": "VIII",
      "9": "IX",
      "10": "X"
    },
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": 5,
      "HDMI-A-1": 3
    }
  },
  "niri/window": {
    "format": "{title}",
    "max-length": 35,
    "tooltip": false,
    "all-outputs": true
  },
  "pulseaudio": {
    "format": "{icon}   {volume}% {format_source}",
    "format-bluetooth": "{icon}   {volume}% {format_source}",
    "format-bluetooth-muted": "󰝟   {icon} {format_source}",
    "format-muted": "󰝟   Muted {format_source}",
    "format-source": "󰍬   {volume}%",
    "format-source-muted": "󰍭",
    "format-icons": {
      "headphone": "",
      "hands-free": "󱡒",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ],
    },
    "on-click": "pavucontrol",
    "tooltip": false,
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}   {percent}%",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "on-scroll-up": "brightnessctl set 1%+",
    "on-scroll-down": "brightnessctl set 1%-",
    "tooltip": false
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8,
    "tooltip": false
  },
  "niri/language": {
    "format": "󰌌  {short}",
    "tooltip-format": "Language: {long}"
  },
  "keyboard-state": {
    "capslock": true,
    "format": "{icon}",
    "format-icons": {
      "locked": "",
      "unlocked": ""
    }
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}   {capacity}%",
    "format-charging": "   {capacity}%",
    "format-plugged": "   {capacity}%",
    "format-alt": "{icon}   {time}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip": false
  },
  "clock": {
    "format": "   {:%I:%M %p}",
    "format-alt": "   {:%Y-%m-%d}",
    "tooltip": false
  },
  "custom/swaync": {
    "format": " ",
    "on-click": "swaync-client -t",
    "on-click-right": "swaync-client -c",
    "tooltip": false
  }
}
