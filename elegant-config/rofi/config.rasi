

@theme "colors.rasi"

configuration {
    modi:                       "drun,run,window";
    show-icons:                 true;

    display-drun:               "";
    display-run:                "";
    display-window:             "";

    drun-display-format:        "{name}";
    font:                       "Ubuntu Nerd Font Medium 14";
}

window {
    transparency:               "real";

    location:                   center;
    anchor:                     center;
    fullscreen:                 false;

    width:                      620px;

    margin:                     0px;
    padding:                    0px;

    border:                     1px solid;
    border-radius:              28px;

    border-color:               rgba(255,255,255,0.08);

    background-color:           rgba(20,20,20,0.65);

    cursor:                     "default";
}

mainbox {
    spacing:                    0px;
    margin:                     0px;
    padding:                    26px;

    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    spacing:                    14px;

    margin:                     0px 0px 22px 0px;

    padding:                    18px 22px;

    border:                     1px solid;
    border-radius:              999px;

    border-color:               rgba(255,255,255,0.06);

    background-color:           rgba(255,255,255,0.07);

    text-color:                 @on-surface;

    children:                   [ "prompt", "entry" ];
}

prompt {
    background-color:           transparent;
    text-color:                 @primary;
}

entry {
    background-color:           transparent;
    text-color:                 @on-surface;

    placeholder:                "Search";
    placeholder-color:          rgba(255,255,255,0.45);

    cursor:                     text;
}

listview {
    columns:                    1;
    lines:                      6;

    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;

    spacing:                    10px;

    background-color:           transparent;
    text-color:                 @on-surface;

    cursor:                     "default";
}

element {
    spacing:                    18px;

    padding:                    14px 18px;

    border:                     0px;
    border-radius:              18px;

    background-color:           transparent;

    text-color:                 @on-surface;

    cursor:                     pointer;
}

element normal.normal {
    background-color:           transparent;
    text-color:                 @on-surface;
}

element selected.normal {
    background-color:           rgba(255,255,255,0.12);

    text-color:                 rgb(255,255,255);
}

element alternate.normal {
    background-color:           transparent;
    text-color:                 @on-surface;
}

element-icon {
    background-color:           transparent;

    size:                       24px;

    cursor:                     inherit;
}

element-text {
    background-color:           transparent;

    text-color:                 inherit;

    highlight:                  @primary;

    vertical-align:             0.5;
    horizontal-align:           0.0;

    cursor:                     inherit;
}

error-message {
    padding:                    22px;

    border:                     1px solid;
    border-radius:              22px;

    border-color:               @error;

    background-color:           rgba(80,20,20,0.85);

    text-color:                 @on-error-container;
}
