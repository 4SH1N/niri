

@theme "colors.rasi"

configuration {
    font:                       "Ubuntu Nerd Font Medium 12";

    show-icons:                 true;
    icon-theme:                 "Papirus";

    display-drun:               "󰸉";

    drun-display-format:        "{name}";

    disable-history:            false;
    fullscreen:                 false;

    hide-scrollbar:             true;
    sidebar-mode:               false;
}


window {
    transparency:               "real";

    background-color:           rgba(20,20,20,0.65);
    text-color:                 @on-surface;

    border:                     1px solid;
    border-radius:              32px;
    border-color:               rgba(255,255,255,0.08);

    width:                      92%;
    height:                     78%;

    location:                   center;
    anchor:                     center;
}


mainbox {
    background-color:           transparent;

    children:                   [ "inputbar", "listview" ];

    spacing:                    24px;

    padding:                    28px;
}


inputbar {
    children:                   [ "prompt", "entry" ];

    background-color:           rgba(255,255,255,0.07);

    border:                     1px solid;
    border-radius:              999px;
    border-color:               rgba(255,255,255,0.06);

    padding:                    16px 22px;

    spacing:                    14px;
}

prompt {
    enabled:                    true;

    background-color:           transparent;

    text-color:                 @primary;
}

entry {
    background-color:           transparent;

    text-color:                 @on-surface;

    placeholder-color:          rgba(255,255,255,0.45);

    placeholder:                "Search Wallpapers";

    expand:                     true;
}


listview {
    background-color:           transparent;

    columns:                    5;
    lines:                      3;

    spacing:                    18px;

    cycle:                      true;
    dynamic:                    true;

    layout:                     vertical;
}


element {
    orientation:                vertical;

    background-color:           transparent;

    border-radius:              24px;

    padding:                    14px;

    spacing:                    12px;
}


element normal.normal {
    background-color:           rgba(255,255,255,0.05);
    text-color:                 @on-surface;
}


element alternate.normal {
    background-color:           rgba(255,255,255,0.05);
    text-color:                 @on-surface;
}


element selected.normal {
    background-color:           @secondary-container;

    text-color:                 @on-secondary-container;

    border:                     1px solid;
    border-color:               rgba(255,255,255,0.08);
}


element-icon {
    size:                       140px;

    border-radius:              18px;

    background-color:           transparent;
}

element-text {
    background-color:           transparent;

    text-color:                 inherit;

    horizontal-align:           0.5;
    vertical-align:             0.5;

    margin:                     4px 0px 0px 0px;
}
